<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>DRM Detector</AssemblyTitle>
    <Product>DRM Detector</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Release: self-contained single exe; `dotnet publish` places it in .\publish -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Keep the publish output a single file: drop non-English satellite assemblies -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>publish\</PublishDir>
  </PropertyGroup>

</Project>
