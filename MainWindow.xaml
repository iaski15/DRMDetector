<Window x:Class="DRMDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DRM Detector" Height="650" Width="850"
        Background="{StaticResource PrimaryBackground}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBackground}" 
                BorderBrush="{StaticResource PrimaryPurple}" BorderThickness="0,0,0,2">
            <StackPanel VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="DRM DETECTOR" FontSize="30" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimary}" 
                           FontFamily="Segoe UI"/>
                <TextBlock Text="Game Protection Analysis Tool" FontSize="12" 
                           Foreground="{StaticResource AccentPurple}" 
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- File Selection Card -->
            <Border Grid.Row="0" Background="{StaticResource CardBackground}" 
                    CornerRadius="10" Padding="24" Margin="0,0,0,16"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="SELECT GAME PATH" FontSize="11" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SelectedPathText" Text="No path selected..." 
                                   FontSize="14" Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="BROWSE FOLDER" 
                            Click="BrowseFolder_Click"
                            Width="150" Height="42" Margin="0,0,12,0"
                            Background="{StaticResource SecondaryBackground}"
                            Foreground="{StaticResource TextPrimary}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            FontWeight="SemiBold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="12,8">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryPurple}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryPurple}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="2" Content="BROWSE FILE" 
                            Click="BrowseFile_Click"
                            Width="150" Height="42"
                            Background="{StaticResource PrimaryPurple}"
                            Foreground="{StaticResource TextPrimary}"
                            BorderThickness="0"
                            FontWeight="SemiBold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="12,8">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentPurple}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Scan Button -->
            <Button Grid.Row="1" x:Name="ScanButton" Content="START SCAN" 
                    Click="ScanButton_Click"
                    Height="52" Margin="0,0,0,16"
                    Background="{StaticResource PrimaryPurple}"
                    Foreground="{StaticResource TextPrimary}"
                    BorderThickness="0"
                    FontSize="15" FontWeight="Bold" Cursor="Hand"
                    IsEnabled="False">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Padding="12,8">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentPurple}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Results -->
            <Border Grid.Row="2" Background="{StaticResource CardBackground}" 
                    CornerRadius="10" Padding="24"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DETECTION RESULTS" FontSize="12" 
                               Foreground="{StaticResource TextSecondary}" 
                               FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ResultsPanel">
                            <TextBlock Text="Select a file or folder to begin scanning..." 
                                       Foreground="{StaticResource TextSecondary}" 
                                       FontSize="14" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Margin="0,60,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="{StaticResource SecondaryBackground}" 
                    CornerRadius="8" Padding="14,10" Margin="0,16,0,0">
                <TextBlock x:Name="StatusText" Text="Ready" 
                           Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>
